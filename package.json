{
  "name": "@klangai/pianissimo-cli",
  "version": "0.2.1",
  "description": "Swedish speech to text for files, podcasts and media URLs, powered by Klang Pianissimo.",
  "type": "module",
  "bin": {
    "pianissimo": "bin/pianissimo.js"
  },
  "files": [
    "bin",
    "dist",
    "worker/*.py",
    "worker/requirements.txt",
    "README.md",
    "VALIDATION.md",
    "NOTICE",
    "REVIEW.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:worker": "python3 -m unittest discover -s test -p '*_test.py'",
    "check": "npm run typecheck && npm test && npm run test:worker && npm run build",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test:media": "node --import tsx scripts/test-media-integration.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "env-paths": "^4.0.0",
    "fast-xml-parser": "^5.11.1",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
